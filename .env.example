# Server ports
PORT=8787
HTTPS_PORT=8443
# Set to 0 to disable the self-signed HTTPS listener (e.g. behind a real TLS proxy / tunnel)
HTTPS=1
# Public URL the QR code should point to (e.g. https://abcd.trycloudflare.com or https://games.example.com)
PUBLIC_URL=
# Avatar pipeline
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
TRIPO_API_KEY=
# Optional: Tiger Data (Timescale/Postgres) connection string for match + motion stats
DATABASE_URL=
